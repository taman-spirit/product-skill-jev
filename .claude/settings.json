{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(//**)",
      "Glob(//**)",
      "Grep(//**)",
      "Write(my-projects/**)",
      "Edit(my-projects/**)",
      "Write(_system/**)",
      "Edit(_system/**)",
      "Bash(make *)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/*secret*)",
      "Read(**/*credential*)",
      "Bash(rm -rf *)"
    ]
  },
  "env": {
    "PM_WORKSPACE": "."
  }
}
