# ── Required ─────────────────────────────────────────────────────────────────

# Telegram bot token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_token_here

# Your Telegram chat ID - limits who can use the bot (recommended)
# To find your chat ID: message @userinfobot on Telegram
ALLOWED_CHAT_IDS=your_chat_id_here

# ── AI Provider ───────────────────────────────────────────────────────────────
# Choose one provider below. Comment out the others.

# ── Option 1: Groq (FREE - recommended) ──────────────────────────────────────
# Fast, generous free tier: 14,400 requests/day, no credit card needed
# Get your free key at: https://console.groq.com
AI_PROVIDER=openai
OPENAI_API_KEY=gsk_your_groq_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# ── Option 2: Anthropic Claude (best quality) ─────────────────────────────────
# Get your key at: https://console.anthropic.com/settings/keys
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_key_here
# claude-sonnet-4-6  $3/$15 per 1M tokens - recommended
# claude-opus-4-7    $5/$25 per 1M tokens - highest quality
# claude-haiku-4-5   $1/$5 per 1M tokens  - fastest
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Option 3: Google Gemini (free tier available) ─────────────────────────────
# Get your key at: https://aistudio.google.com/apikey
# Note: free tier limited to 15 requests/minute
# AI_PROVIDER=google
# GOOGLE_API_KEY=your_key_here
# GEMINI_MODEL=gemini-2.0-flash

# ── Option 4: OpenAI GPT ──────────────────────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_key_here
# OPENAI_MODEL=gpt-4o-mini

# ── Option 5: Ollama (free, runs locally) ────────────────────────────────────
# Install from https://ollama.com then run: ollama pull llama3.1
# AI_PROVIDER=openai
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_MODEL=llama3.1

# TypeSafe AI (Jev System One model) - https://console.typesafe.ai/keys
# Leave TYPESAFE_API_KEY empty to run without Jev. Every code path falls back to
# the behaviour the bot had before Jev existed, so nothing breaks.
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
# Optional. Defaults: https://api.typesafe.ai and 3.0 seconds.
# TYPESAFE_BASE_URL=
# TYPESAFE_TIMEOUT=3.0
